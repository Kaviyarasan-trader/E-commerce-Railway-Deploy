# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
# healthcheck.railway.app and RAILWAY_PUBLIC_DOMAIN are added automatically.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Razorpay (get test keys from https://dashboard.razorpay.com/)
# Leave unset to run in demo/mock mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Database (defaults to SQLite if not set)
# Railway sets DATABASE_URL automatically when a Postgres plugin is attached.
DATABASE_URL=sqlite:///db.sqlite3

# Google Maps (get API key from https://console.cloud.google.com/)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Sign-In (OAuth 2.0) - create a Web OAuth client in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_web_client_secret
# Optional - canonical domain used to build the Google OAuth redirect URI in
# production. Defaults to Railway's current RAILWAY_PUBLIC_DOMAIN; set this to
# override (e.g. a custom domain). The callback is always
# https://<SITE_DOMAIN or RAILWAY_PUBLIC_DOMAIN>/google-auth/callback.
# SITE_DOMAIN=kavibazaar-production.up.railway.app

# Gmail SMTP (use App Password from https://myaccount.google.com/apppasswords, NOT your normal Gmail password)
# If EMAIL_HOST_PASSWORD is empty, the console email backend is used instead.
EMAIL_HOST_USER=yourgmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-16-char-app-password
# Optional - SMTP connect timeout in seconds (default 15). Prevents a stuck
# SMTP connection from blocking a Gunicorn worker.
EMAIL_TIMEOUT=15

# SendGrid HTTPS API (https://sendgrid.com/) - required for OTP emails on
# Railway: Railway blocks outbound SMTP on Hobby/free plans. When this key is
# set, OTP emails are sent via SendGrid's HTTPS API instead of Gmail SMTP
# (local dev with EMAIL_HOST_PASSWORD still uses Gmail SMTP). Verify the
# "from" sender in SendGrid before sending.
SENDGRID_API_KEY=SG.your_sendgrid_api_key
# "From" address for SendGrid OTP emails (defaults to EMAIL_HOST_USER if unset).
SENDGRID_FROM_EMAIL=kavibazaar@gmail.com

# CSRF (defaults to http://127.0.0.1,http://localhost; the Railway public
# domain is appended automatically when RAILWAY_PUBLIC_DOMAIN is set)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Optional - set automatically by Railway on deploy.
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# Optional - override production security defaults (only applied when DJANGO_DEBUG=False).
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
